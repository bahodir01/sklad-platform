# Платформа складского учёта — переменные окружения.
# Скопировать в .env и заполнить. .env в git не коммитится.

# ── PostgreSQL 16 ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sklad:sklad@db:5432/sklad

# ── Redis (кеш/брокер + хранилище refresh-сессий) ────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ─────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО заменить в prod: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Secure-cookie: false только для локальной разработки по http.
# В prod — строго true (ТЗ §7: HTTPS).
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# ── MinIO / S3 ──────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000

# ── Приложение ──────────────────────────────────────────────────────
ENVIRONMENT=dev
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# ── Стартовый администратор (python -m app.seed) ─────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULL_NAME=Заведующий складом
SEED_ADMIN_PASSWORD=
