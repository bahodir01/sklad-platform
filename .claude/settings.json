      "Bash(pnpm *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(wc *)",
      "Bash(sed *)",
      "Bash(diff *)",
